# grammar-mcp's one-time build container: a base, its build tools, and Rust.
#
# Built and run by run.bash beside it, then removed with its image: BASE is the
# machine's own distribution, of the Fedora family or the Debian family, RUST
# the toolchain.

ARG BASE=registry.fedoraproject.org/fedora:44
FROM ${BASE}

ARG RUST=1.99.1

RUN if command -v dnf >/dev/null 2>&1; then \
        dnf install -y --setopt=install_weak_deps=False \
            gcc gcc-c++ make cmake clang perl pkgconf-pkg-config openssl-devel \
            git tar zstd rustup \
        && dnf clean all \
        && rustup-init -y --no-modify-path --profile minimal \
            --default-toolchain "${RUST}"; \
    elif command -v apt-get >/dev/null 2>&1; then \
        export DEBIAN_FRONTEND=noninteractive \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
            build-essential cmake clang perl pkg-config libssl-dev \
            git tar zstd ca-certificates rustup \
        && rm -rf /var/lib/apt/lists/* \
        && case "$(uname -m)" in \
               riscv64) host=riscv64gc-unknown-linux-gnu ;; \
               *) host="$(uname -m)-unknown-linux-gnu" ;; \
           esac \
        && rustup set default-host "${host}" \
        && rustup toolchain install --profile minimal "${RUST}" \
        && rustup default "${RUST}"; \
    else \
        echo "the base has neither dnf nor apt-get" >&2; \
        exit 1; \
    fi

ENV PATH=/root/.cargo/bin:${PATH}
