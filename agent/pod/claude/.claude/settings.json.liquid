{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "autoMemoryDirectory": "{{ai_repo_dir}}",
  "idleCompaction": false,
  "disableRemoteControl": true,
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".grammar/bash/no.bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'NOTICE: You have just auto-compacted. Use Grammar MCP interface(interface info) immediately. Use Grammar MCP call(gram:iter:load) immediately.'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".grammar/nu/statusline.nu"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
